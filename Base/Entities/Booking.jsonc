{
  "name": "Booking",
  "type": "object",
  "properties": {
    "court_id": {
      "type": "string"
    },
    "court_name": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "court",
        "training"
      ],
      "default": "court"
    },
    "day_index": {
      "type": "number"
    },
    "day_label": {
      "type": "string"
    },
    "slot": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "confirmed"
    }
  },
  "required": [
    "court_id",
    "slot",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}