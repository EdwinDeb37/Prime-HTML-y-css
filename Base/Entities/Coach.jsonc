{
  "name": "Coach",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blackout": {
      "type": "object"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "sport",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}